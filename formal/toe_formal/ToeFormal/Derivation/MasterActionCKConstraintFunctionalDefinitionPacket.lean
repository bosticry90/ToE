theorem packet_consumes_definition_target_and_selects_review :
    consumedTarget =
        "prepare_master_action_ck_constraint_functional_definition_packet" ∧
      selectedNextTarget =
        "review_master_action_ck_constraint_functional_definition_packet_result" ∧
      selectedNextTargetKind =
        "master_action_ck_constraint_functional_definition_packet_result_review" := by
  decide

theorem packet_indexes_option_menu_without_selection :
    packetResult =
        "CK_CONSTRAINT_FUNCTIONAL_OPTIONS_INDEXED_NO_SELECTION" ∧
      outcomeId =
        "MASTER_ACTION_CK_CONSTRAINT_FUNCTIONAL_DEFINITION_PACKET_PREPARED_" ++
          "CK_CONSTRAINT_FUNCTIONAL_OPTIONS_INDEXED_NO_SELECTION" ∧
      priorCKVariationalContentOutcome =
        "TOE_NATIVE_PHI_CK_VARIATIONAL_CONTENT_PACKET_PREPARED_" ++
          "CK_VARIATIONAL_CONTENT_BLOCKED_BY_UNSPECIFIED_CONSTRAINT_FUNCTIONALS" ∧
      masterActionCKSurface =
        "sum_k lambda_k * C_k(g, psi, A, phi, rho)" ∧
      constraintActionForm =
        "S_C = integral_M d^4x sqrt(-g) sum_k lambda_k " ++
          "C_k(g, psi, A, phi, rho)" ∧
      lambdaVariationForm =
        "delta S_C/delta lambda_k = C_k(g, psi, A, phi, rho) = 0" ∧
      phiVariationForm =
        "delta S_C/delta phi_i = sum_k lambda_k delta C_k/delta phi_i" ∧
      optionClassCount = 7 ∧
      packetCriteriaCount = 11 ∧
      packetCriteriaAcceptedCount = 11 := by
  decide

