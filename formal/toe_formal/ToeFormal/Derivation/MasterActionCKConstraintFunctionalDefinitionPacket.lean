import ToeFormal.Derivation.ToeNativePhiCKVariationalContentPacket

/-
Record marker for the master-action C_k constraint-functional definition packet.

The packet indexes legal C_k option classes and records the multiplier, phi,
and metric variation contracts. It does not select a concrete C_k family and
does not claim that C_k content is fully defined, that phi is generated by C_k,
or that source admissibility, conservation, QFT-GR closure, or master-action
promotion has been proved.
-/

namespace ToeFormal
namespace Derivation
namespace MasterActionCKConstraintFunctionalDefinitionPacket

def packetId : String :=
  "MASTER_ACTION_CK_CONSTRAINT_FUNCTIONAL_DEFINITION_PACKET_v0"

def packetResult : String :=
  "CK_CONSTRAINT_FUNCTIONAL_OPTIONS_INDEXED_NO_SELECTION"

def outcomeId : String :=
  "MASTER_ACTION_CK_CONSTRAINT_FUNCTIONAL_DEFINITION_PACKET_PREPARED_" ++
    "CK_CONSTRAINT_FUNCTIONAL_OPTIONS_INDEXED_NO_SELECTION"

def consumedTarget : String :=
  ToeNativePhiCKVariationalContentPacket.selectedNextTarget

def selectedNextTarget : String :=
  "review_master_action_ck_constraint_functional_definition_packet_result"

def selectedNextTargetKind : String :=
  "master_action_ck_constraint_functional_definition_packet_result_review"

def priorCKVariationalContentOutcome : String :=
  ToeNativePhiCKVariationalContentPacket.outcomeId

def masterActionCKSurface : String :=
  ToeNativePhiCKVariationalContentPacket.masterActionCKSurface

def constraintActionForm : String :=
  "S_C = integral_M d^4x sqrt(-g) sum_k lambda_k " ++
    "C_k(g, psi, A, phi, rho)"

def lambdaVariationForm : String :=
  "delta S_C/delta lambda_k = C_k(g, psi, A, phi, rho) = 0"

def phiVariationForm : String :=
  "delta S_C/delta phi_i = sum_k lambda_k delta C_k/delta phi_i"

def metricVariationForm : String :=
  "delta S_C/delta g^{mu nu} contributes a constraint stress-energy or " ++
    "gravity-side stationarity term only when C_k has metric dependence and " ++
    "a defined variational derivative"

def optionClassCount : Nat := 7
def packetCriteriaCount : Nat := 11
def packetCriteriaAcceptedCount : Nat := 11

def bridgeAdmissibilityConstraintId : String :=
  "bridge_admissibility_constraint"

def conservationConstraintId : String :=
