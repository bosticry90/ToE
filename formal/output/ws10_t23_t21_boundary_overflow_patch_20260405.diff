+from __future__ import annotations
+
+from pathlib import Path
+
+
+def find_repo_root(start: Path) -> Path:
+    p = start.resolve()
+    while p != p.parent:
+        if (p / "formal").exists():
+            return p
+        p = p.parent
+    raise RuntimeError("Could not locate repo root (expected a 'formal' directory).")
+
+
+REPO_ROOT = find_repo_root(Path(__file__))
+PROGRAM_PATH = REPO_ROOT / "formal" / "docs" / "release" / "WS_10_REMEDIATION_EXECUTION_PROGRAM_20260404_v0.md"
+
+
+def _read(path: Path) -> str:
+    assert path.exists(), f"Missing required file: {path}"
+    return path.read_text(encoding="utf-8")
+
+
+def _phase_b_matrix_rows(text: str) -> list[list[str]]:
+    start_marker = "## Phase B authority ownership matrix"
+    end_marker = "## Phase B status"
+    assert start_marker in text, "Missing Phase B authority ownership matrix section."
+    assert end_marker in text, "Missing Phase B status section."
+
+    section = text.split(start_marker, 1)[1].split(end_marker, 1)[0]
+    rows: list[list[str]] = []
+    for line in section.splitlines():
+        stripped = line.strip()
+        if not stripped.startswith("|"):
+            continue
+        cells = [cell.strip() for cell in stripped.split("|")[1:-1]]
+        if not cells or cells[0] in {"authority_surface", "---"}:
+            continue
+        rows.append(cells)
+    return rows
+
+
+def test_ws10_t21_matrix_has_required_rows() -> None:
+    text = _read(PROGRAM_PATH)
+    rows = _phase_b_matrix_rows(text)
+    assert rows, "Phase B authority ownership matrix has no data rows."
+    expected_surfaces = {
+        "remediation_program_status",
+        "remediation_program_doc_pointer",
+        "remediation_program_phase_b_gate_pointer",
+        "remediation_authority_ownership_matrix_pointer",
+    }
+    found_surfaces = {row[0] for row in rows}
+    missing = sorted(expected_surfaces - found_surfaces)
+    assert not missing, "Missing authority surface row(s): " + ", ".join(missing)
+
+
+def test_ws10_t21_matrix_surface_uniqueness_and_owners() -> None:
+    text = _read(PROGRAM_PATH)
+    rows = _phase_b_matrix_rows(text)
+
+    surfaces = [row[0] for row in rows]
+    assert len(surfaces) == len(set(surfaces)), "Duplicate authority_surface entries in Phase B matrix."
+
+    for row in rows:
+        assert len(row) == 4, f"Unexpected matrix column count for row: {row}"
+        canonical_owner = row[1]
+        enforcement_gate = row[3]
+        assert canonical_owner, f"Empty canonical_owner in row: {row}"
+        assert "formal/python/tests/test_ws10_t21_" in enforcement_gate, (
+            "Phase B matrix row must point to a T21 enforcement gate: "
+            f"{row}"
+        )
